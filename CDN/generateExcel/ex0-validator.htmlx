<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Example 0(Empty Excel)</title>
    <style>
        body {
            background: #222831;
            color: #F6F6F6;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        button {
            cursor: pointer;
            border: none;
            padding: 5px;
            border-radius: 4px;
            background: #F6F6F6;
        }
    </style>
</head>

<body>
    <p>For generate Excel please click the below button</p>
    <button onclick="generateExcel()" data-testid="generate-excel-btn">Generate Excel</button>
    <script src="../dist/excel-table.umd.cjs"></script>
    <script>
        const data = {
            fileName: "ex0-0",
            sheet: [{}, {}, {}, {}],
        };
        function generateExcel() {
            ExcelTable.Validator.validateExcelTableObjectFunction(data)
        }
    </script>
</body>

</html>